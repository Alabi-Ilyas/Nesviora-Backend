NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nesviora
# Use long random strings (32+ chars), different for each. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Comma-separated list of frontend origins allowed to call the API
CLIENT_URL=http://localhost:5173
# 'lax' if frontend and API share a site, 'none' if they are on different domains (requires HTTPS)
COOKIE_SAMESITE=lax
# Used only by: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
